# Copy to .env (git-ignored) and fill in only what you use.
# Never commit .env. Prompts and images go to whichever hosted provider you enable.

# Default providers. Required when more than one provider of that kind is configured.
# Text: claude, gemini, openai, grok, ollama. Image: gemini, openai, grok.
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=

# Provider keys (setting a key enables that provider).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Model overrides. Claude defaults to claude-sonnet-5-5 with effort medium.
CLAUDE_TEXT_MODEL=
GEMINI_TEXT_MODEL=
OPENAI_TEXT_MODEL=

# Ollama: setting OLLAMA_MODEL enables it. Loopback unless the host is allowed below.
OLLAMA_MODEL=
OLLAMA_HOST=
# Comma-separated hosts (besides loopback) that local providers may use.
AI_ALLOWED_HOSTS=

# Limits (defaults shown in README).
AI_TIMEOUT_MS=
AI_MAX_PROMPT_CHARS=
AI_MAX_IMAGES=
AI_MAX_IMAGE_BYTES=

# HTTP transport (Stage 3). Leave MCP_AUTH_TOKEN empty to generate one on first run.
MCP_HTTP_PORT=
MCP_AUTH_TOKEN=
MCP_ALLOWED_ORIGINS=
