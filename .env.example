# Copy to .env (git-ignored) and fill in only what you use.
# Never commit .env. Prompts and images go to whichever hosted provider you enable.

# Default providers. Required when more than one provider of that kind is configured.
# Text: claude, gemini, openai, grok, openrouter, ollama, lmstudio, vllm,
# llamacpp, openai-compatible. Image: gemini, openai, grok.
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=

# Provider keys (setting a key enables that provider).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Model overrides. Claude defaults to claude-sonnet-5-5 with effort medium.
CLAUDE_TEXT_MODEL=
GEMINI_TEXT_MODEL=
OPENAI_TEXT_MODEL=
OPENROUTER_MODEL=

# Ollama: setting OLLAMA_MODEL enables it. Loopback unless the host is allowed below.
OLLAMA_MODEL=
OLLAMA_HOST=

# Other local text servers (OpenAI protocol). Each is enabled by its model variable;
# the host defaults to the server's usual port and the key is only for servers started
# with one. openai-compatible (Jan, LocalAI, ...) has no usual port, so its host is required.
LMSTUDIO_MODEL=
LMSTUDIO_HOST=
LMSTUDIO_API_KEY=
VLLM_MODEL=
VLLM_HOST=
VLLM_API_KEY=
LLAMACPP_MODEL=
LLAMACPP_HOST=
LLAMACPP_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_HOST=
OPENAI_COMPATIBLE_API_KEY=
# Comma-separated hosts (besides loopback) that local providers may use.
AI_ALLOWED_HOSTS=

# Limits (defaults shown in README).
AI_TIMEOUT_MS=
AI_MAX_PROMPT_CHARS=
AI_MAX_IMAGES=
AI_MAX_IMAGE_BYTES=
# Largest generated image returned to the client (default 16 MiB).
AI_MAX_OUTPUT_IMAGE_BYTES=

# HTTP transport: run with --http or MCP_TRANSPORT=http. Binds 127.0.0.1 only.
MCP_TRANSPORT=
MCP_HTTP_PORT=
# 24+ characters. Leave empty to read or generate one in MCP_TOKEN_FILE (mode 0600).
MCP_AUTH_TOKEN=
MCP_TOKEN_FILE=
# Exact origins allowed to call from a browser, comma-separated, no wildcards.
MCP_ALLOWED_ORIGINS=
# Containers only: bind a non-loopback address inside, publish on 127.0.0.1 outside.
MCP_HTTP_HOST=
MCP_HTTP_ALLOW_NON_LOOPBACK=
# Extra Host header values (host:port) accepted besides the loopback names.
# Needed when a published port differs from the bound one, e.g. 127.0.0.1:9000.
MCP_ALLOWED_HOSTS=

# docker compose only: the host port published on 127.0.0.1 (default 8787).
MCP_HOST_PORT=
