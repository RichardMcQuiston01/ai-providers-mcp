  },
  "homepage": "https://github.com/RichardMcQuiston01/ai-providers-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/ai-providers-mcp.git"
  },
  "bugs": {
